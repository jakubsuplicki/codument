{
  "name": "codument",
  "version": "0.5.0",
  "description": "Docs-backed delivery workflow for AI coding agents",
  "type": "module",
  "bin": {
    "codument": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "agents",
    "rules",
    "fixtures"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsup >/dev/null && node dist/cli.js demo",
    "demo:live": "tsup >/dev/null && node dist/cli.js demo --live"
  },
  "keywords": [
    "ai-agents",
    "codex",
    "claude",
    "documentation",
    "delivery-workflow",
    "ai",
    "docs"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2"
  }
}
