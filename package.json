{
  "name": "codument",
  "version": "0.14.0",
  "description": "Docs-based guardrails for AI coding workflows: coverage scoring, doc-drift checks, and diff safety review.",
  "type": "module",
  "bin": {
    "codument": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "agents",
    "rules",
    "fixtures",
    "grammars",
    "!**/*.map"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./tests",
    "lint:fix": "biome lint --write ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "test": "NO_COLOR=1 tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "demo": "tsup >/dev/null && node dist/cli.js demo",
    "demo:live": "tsup >/dev/null && node dist/cli.js demo --live"
  },
  "keywords": [
    "ai-agents",
    "claude",
    "change-control",
    "code-review",
    "guardrails",
    "diff-review",
    "documentation",
    "docs",
    "ai"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "typescript": "6.0.2",
    "web-tree-sitter": "0.26.10"
  }
}
