{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "codument",
          "informationUri": "https://github.com/jakubsuplicki/codument",
          "rules": [
            {
              "id": "codument/stale-doc",
              "name": "StaleDoc",
              "shortDescription": {
                "text": "A feature's source changed but its owning doc did not."
              },
              "helpUri": "https://github.com/jakubsuplicki/codument/blob/main/docs/features/change-control-gate.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "codument/unmapped-source",
              "name": "UnmappedSource",
              "shortDescription": {
                "text": "A changed source file has no owning doc in the registry."
              },
              "helpUri": "https://github.com/jakubsuplicki/codument/blob/main/docs/features/registry-health.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "codument/out-of-plan",
              "name": "OutOfPlan",
              "shortDescription": {
                "text": "A changed file falls outside the approved plan's scope."
              },
              "helpUri": "https://github.com/jakubsuplicki/codument/blob/main/docs/features/change-control-gate.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "codument/ownership-lint",
              "name": "OwnershipLint",
              "shortDescription": {
                "text": "A symbol on a shared file could not be resolved to a single owning feature."
              },
              "helpUri": "https://github.com/jakubsuplicki/codument/blob/main/docs/features/change-control-gate.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "codument/unevaluable",
              "name": "Unevaluable",
              "shortDescription": {
                "text": "A changed source file could not be parsed (parse error or conflict markers)."
              },
              "helpUri": "https://github.com/jakubsuplicki/codument/blob/main/docs/features/change-control-gate.md",
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [],
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "codument gate could not run: not a git repository"
              }
            }
          ]
        }
      ]
    }
  ]
}
